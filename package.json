{
  "name": "aetheria-world-shaper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "assets:polyhaven": "node tools/assets/polyhaven-pack.mjs --pack web-1k",
    "assets:polyhaven:desktop-2k": "node tools/assets/polyhaven-pack.mjs --pack desktop-2k",
    "assets:polyhaven:desktop-4k": "node tools/assets/polyhaven-pack.mjs --pack desktop-4k",
    "assets:verify": "node tools/assets/verify-polyhaven-pack.mjs",
    "assets:verify:tree": "node tools/assets/verify-polyhaven-tree-model.mjs",
    "assets:tree:web-1k": "node tools/assets/polyhaven-tree-model.mjs --pack web-1k",
    "assets:tree:desktop-2k": "node tools/assets/polyhaven-tree-model.mjs --pack desktop-2k",
    "assets:tree:desktop-4k": "node tools/assets/polyhaven-tree-model.mjs --pack desktop-4k",
    "assets:jacaranda:web-1k": "node tools/assets/polyhaven-tree-model.mjs --asset jacaranda_tree --pack web-1k",
    "assets:jacaranda:desktop-2k": "node tools/assets/polyhaven-tree-model.mjs --asset jacaranda_tree --pack desktop-2k",
    "assets:jacaranda:desktop-4k": "node tools/assets/polyhaven-tree-model.mjs --asset jacaranda_tree --pack desktop-4k"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
